{
  "manifest_version": 3,
  "name": "Kairos Tool",
  "version": "1.1",
  "description": "Kairos Standalone Tool - Toolbar with Chat, SMS, System, Calculator, Email and configurable action buttons.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://kairos.breadfast.com/*",
    "*://*.breadfast.com/*",
    "*://breadfast.com/*",
    "*://*.freshdesk.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kairos.breadfast.com/*",
        "*://*.breadfast.com/*",
        "*://breadfast.com/*",
        "*://*.freshdesk.com/*",
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
