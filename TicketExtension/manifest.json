{
  "manifest_version": 3,
  "name": "Freshdesk Ticket Buttons",
  "version": "2.1",
  "description": "Adds Create Ticket, Senior Ticket, Tree Menu, RMS, Chat, and Delay Calculator buttons to Freshdesk ticket pages.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.breadfast.com/*",
    "*://breadfast.com/*",
    "*://*.freshdesk.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.freshdesk.com/*",
        "*://*.breadfast.com/*",
        "*://breadfast.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}